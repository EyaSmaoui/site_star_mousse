{
  "name": "site-star-mousse-backend",
  "version": "2.2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "nodemon --max-http-header-size=16384 app.js",
    "dev:api": "nodemon --max-http-header-size=16384 app.js",
    "start": "node --max-http-header-size=16384 app.js",
    "seed": "node seeders/seed.js",
    "migrate:product-active": "node scripts/migrate-product-active-field.js",
    "test:unit": "node --test tests/*.test.js",
    "check:json": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8')); console.log('backend JSON ok')\""
  },
  "dependencies": {
    "@sentry/node": "^10.58.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.2.1",
    "redis": "^6.0.0",
    "stripe": "^12.7.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14"
  }
}
